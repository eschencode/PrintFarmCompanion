{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "3dtracker",
  "compatibility_date": "2024-11-01",
  "compatibility_flags": ["nodejs_compat_v2"],
  "pages_build_output_dir": ".svelte-kit/cloudflare",
  "d1_databases": [
    {
      "binding": "DB",
      // PRODUCTION DB — bound by production deployments and plain `--remote` CLI
      // commands. Do NOT point this at a test DB; swap only at a deliberate cutover.
      "database_name": "printfarm",
      "database_id": "ccefd784-1193-4936-a093-e1a14eeffcb8",
      // Staging DB ("printfarm") — used by preview deployments and `--remote
      // --preview` CLI commands. Migrated + seeded with test data.
      //"preview_database_id": "ccefd784-1193-4936-a093-e1a14eeffcb8",
      "migrations_dir": "./drizzle",
    },
  ],
  "ai": {
    "binding": "AI",
  },
  // Resend transactional email (password reset + email verification).
  // EMAIL_FROM must be an address on a domain verified in Resend, whose
  // SPF/DKIM records live in Cloudflare DNS. RESEND_API_KEY is a SECRET — do
  // NOT put it here; set it in Pages → Settings → Variables & Secrets, and in
  // .dev.vars for local. Without it, sendEmail() just logs the link.
  "vars": {
    "EMAIL_FROM": "noreply@send.printfarm.tech",
    "EMAIL_FROM_NAME": "Print Farm Companion",
  },
}
