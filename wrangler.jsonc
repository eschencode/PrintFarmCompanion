{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "3dtracker",
  "compatibility_date": "2024-11-01",
  "compatibility_flags": ["nodejs_compat_v2"],
  "pages_build_output_dir": ".svelte-kit/cloudflare",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "printfarm",
      "database_id": "ccefd784-1193-4936-a093-e1a14eeffcb8",
      // Staging DB — used by preview deployments and `--preview` CLI commands.
      //"preview_database_id": "ccefd784-1193-4936-a093-e1a14eeffcb8",
      "migrations_dir": "./drizzle",
    },
  ],
  "ai": {
    "binding": "AI",
  },
}
